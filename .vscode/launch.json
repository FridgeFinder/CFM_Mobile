    {
      "name": "fridgefinder_flutter (profile mode)",
      "cwd": "fridgefinder_flutter",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": ["--dart-define", "flutter.flutter_map.unblockOSM=_____"]
    },
    {
      "name": "fridgefinder_flutter (release mode)",
      "cwd": "fridgefinder_flutter",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": ["--dart-define", "flutter.flutter_map.unblockOSM=_____"]
    }
  ]
