# Android Keystore Configuration Template
#
# INSTRUCTIONS:
# 1. Generate a keystore using the following command:
#    keytool -genkey -v -keystore ~/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to key.properties (in the same directory)
#    cp key.properties.template key.properties
#
# 3. Fill in the values below with your keystore details
#
# 4. IMPORTANT: Never commit key.properties to git!
#    It's already in .gitignore, but double-check!
#
# EXAMPLE VALUES (replace with your actual values):

storePassword=YourStorePassword123
keyPassword=YourKeyPassword123
keyAlias=upload
storeFile=/Users/yourusername/upload-keystore.jks

# SECURITY NOTES:
# - Use strong passwords (16+ characters, mix of letters, numbers, symbols)
# - Store the keystore file in a secure location
# - Backup the keystore file to multiple secure locations
# - If you lose the keystore, you CANNOT update your app in Play Store!
# - Consider using a password manager to store these credentials
