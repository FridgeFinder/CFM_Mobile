# Fastfile for Android

default_platform(:android)

platform :android do

  def validated_app_env(default_value)
    app_env = (ENV["APP_ENV"] || default_value).strip
    unless ["dev", "prod"].include?(app_env)
      UI.user_error!("APP_ENV must be 'dev' or 'prod' (got: #{app_env})")
    end
    app_env
  end

  desc "Generate screenshots for Play Store"
  lane :screenshots do
    # Build the app for screenshots
    gradle(
      task: "assembleDebug",
      project_dir: "."
    )
    
    # Note: Flutter screenshots are typically handled via integration tests
    # This lane can be extended to run Flutter driver screenshot tests
    # For now, we'll use Flutter's screenshot capabilities directly
    sh("cd .. && flutter test integration_test/screenshot_test.dart || true")
  end

  desc "Upload existing APK to Firebase App Distribution"
  lane :beta do
    app_env = validated_app_env("dev")

    # Build APK for direct distribution
    sh("cd .. && flutter build apk --release --dart-define=APP_ENV=#{app_env}")

    # Upload to Firebase App Distribution
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"],
      groups: ENV["FIREBASE_DISTRIBUTION_GROUPS"] || "dev-testers",
      release_notes: ENV["RELEASE_NOTES"] || "Beta build v1.1.0 (19)",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_path: "../build/app/outputs/flutter-apk/app-release.apk"
    )
  end

  desc "Upload existing AAB to Google Play closed testing"
  lane :playstore_beta do
    app_env = validated_app_env("prod")
    sh("cd .. && APP_ENV=#{app_env} ./scripts/require_prod_env.sh")

    # Upload to Google Play Console - Internal Testing Track
    upload_to_play_store(
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      track: "internal",  # Use "internal" for closed testing, "beta" for open testing
      json_key: "../secrets/fridgefinder-app-1-17dbe2831a13.json",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and upload to Google Play Console"
  lane :release do
    app_env = validated_app_env("prod")
    sh("cd .. && APP_ENV=#{app_env} ./scripts/require_prod_env.sh")

    # Ensure we're on the correct branch/tag
    # ensure_git_status_clean

    # Build the app bundle using Flutter
    sh("cd .. && flutter build appbundle --release --dart-define=APP_ENV=#{app_env}")

    # Upload to Google Play Console
    upload_to_play_store(
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      track: "production",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

