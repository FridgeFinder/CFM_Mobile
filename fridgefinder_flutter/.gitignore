# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
# Numbered duplicates created by rsync/iCloud (e.g. ".flutter-plugins-dependencies 2")
.flutter-plugins-dependencies[[:space:]]*
.pub-cache/
.pub/
/build/
/coverage/

# Xcode build artefact duplicates from safe-run script / iCloud sync
**/ios/Flutter/Flutter[[:space:]]*.podspec
**/ios/Flutter/Generated[[:space:]]*.xcconfig
**/ios/Flutter/flutter_export_environment[[:space:]]*.sh
# Xcode scheme backups
**/*.xcscheme.backup

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android keystore (CRITICAL: Never commit these!)
**/key.properties
**/*.jks
**/*.keystore

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output
**/.fastlane
**/fastlane/.env

# App Store Connect API Key
*.p8

# Local env files (contain real API keys — do not commit)
.env

# Screenshots
screenshots/
