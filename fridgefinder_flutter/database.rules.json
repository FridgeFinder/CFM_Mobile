{
  "rules": {
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid || auth != null",
        ".write": "$userId === auth.uid"
      },
      ".read": "auth != null",
      ".indexOn": ["username"]
    },
    "statusReports": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
