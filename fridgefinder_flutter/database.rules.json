{
  "rules": {
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid || auth != null",
        ".write": "$userId === auth.uid"
      },
      ".read": "auth != null",
      ".indexOn": ["username", "createdAt"]
    },
    "statusReports": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "statistics": {
      ".read": "auth != null",
      ".write": false
    },
    "dashboardSessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "accountDeletionCodes": {
      ".read": false,
      ".write": false
    },
    "deletedAccounts": {
      ".read": false,
      ".write": false
    },
    "activityFeed": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["timestamp"]
    },
    "cacheVersions": {
      ".read": "auth != null",
      ".write": false
    },
    "geocodingCache": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
