# Fastfile for iOS

default_platform(:ios)

platform :ios do
  desc "Generate screenshots for App Store"
  lane :screenshots do
    # Build the app for screenshots
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release"
    )
    
    # Capture screenshots
    capture_screenshots(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15 Pro",
        "iPhone 15",
        "iPhone SE (3rd generation)",
        "iPad Pro (12.9-inch) (6th generation)"
      ]
    )
    
    # Upload screenshots to App Store Connect
    upload_to_app_store(
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      skip_app_version_update: true
    )
  end

  desc "Upload existing IPA to Firebase App Distribution"
  lane :upload_beta do
    # Upload to Firebase App Distribution (IPA must already be built)
    firebase_params = {
      googleservice_info_plist_path: "Runner/GoogleService-Info.plist",
      groups: ENV["FIREBASE_DISTRIBUTION_GROUPS"] || "dev-testers",
      release_notes: ENV["RELEASE_NOTES"] || "Beta build from Fastlane",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      ipa_path: "../build/ios/ipa/FridgeFinder.ipa"
    }
    firebase_params[:app] = ENV["FIREBASE_APP_ID_IOS"] if ENV["FIREBASE_APP_ID_IOS"]

    firebase_app_distribution(firebase_params)
  end

  desc "Build and upload to Firebase App Distribution"
  lane :beta do
    # Ensure we're on the correct branch/tag
    # ensure_git_status_clean

    # Set locale to UTF-8 to avoid CocoaPods warnings
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"

    # Install provisioning profile to system location
    # Xcode looks for profiles in ~/Library/MobileDevice/Provisioning Profiles/
    mobileprovision_path = File.expand_path("profiles/firebase-beta.mobileprovision", __dir__)

    if File.exist?(mobileprovision_path)
      UI.message "📦 Installing provisioning profile..."

      # Extract UUID from mobileprovision file
      uuid_command = "security cms -D -i '#{mobileprovision_path}' | plutil -convert xml1 -o - - | grep -A 1 '<key>UUID</key>' | grep '<string>' | sed 's/.*<string>\\(.*\\)<\\/string>.*/\\1/'"
      profile_uuid = sh(uuid_command).strip

      # Create provisioning profiles directory if it doesn't exist
      profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
      sh("mkdir -p '#{profiles_dir}'")

      # Copy profile with UUID as filename
      destination = "#{profiles_dir}/#{profile_uuid}.mobileprovision"
      sh("cp '#{mobileprovision_path}' '#{destination}'")

      UI.success "✅ Provisioning profile installed: #{profile_uuid}"
    else
      UI.important "⚠️  No provisioning profile found at #{mobileprovision_path}"
      UI.important "   Build will use automatic signing or existing profiles"
    end

    # Build the app using Flutter with manual signing
    # Flutter will run pod install automatically during the build
    # Even if it shows a CocoaPods warning, the build still succeeds
    export_options_path = File.expand_path("../ExportOptions.plist", __dir__)
    sh("cd .. && flutter build ipa --release --export-options-plist=#{export_options_path}")
    
    # Upload to Firebase App Distribution
    # Build parameters hash - only include app ID if explicitly set, otherwise use plist
    firebase_params = {
      googleservice_info_plist_path: "Runner/GoogleService-Info.plist",
      groups: ENV["FIREBASE_DISTRIBUTION_GROUPS"] || "dev-testers",
      release_notes: ENV["RELEASE_NOTES"] || "Beta build from Fastlane",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      ipa_path: "../build/ios/ipa/FridgeFinder.ipa"
    }
    firebase_params[:app] = ENV["FIREBASE_APP_ID_IOS"] if ENV["FIREBASE_APP_ID_IOS"]

    firebase_app_distribution(firebase_params)
  end

  desc "Upload existing IPA to App Store Connect"
  lane :upload_release do
    # Set up App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )

    # Upload to App Store Connect
    upload_to_app_store(
      api_key: api_key,
      ipa: "../build/ios/ipa/FridgeFinder.ipa",
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      run_precheck_before_submit: false  # Disable precheck (doesn't work with API keys)
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    # Ensure we're on the correct branch/tag
    # ensure_git_status_clean

    # Set locale to UTF-8 to avoid CocoaPods warnings
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"

    # Flutter will automatically run pod install during the build process
    # Even if it detects CocoaPods as "broken", it usually still works

    # Note: sync_code_signing removed due to issues - certificates should be managed via Xcode automatic signing
    # Or ensure certificates are already in keychain before building

    # Build the app using Flutter
    sh("cd .. && flutter build ipa --release")

    # Set up App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )

    # Upload to App Store Connect
    upload_to_app_store(
      api_key: api_key,
      ipa: "../build/ios/ipa/FridgeFinder.ipa",
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      run_precheck_before_submit: false  # Disable precheck (doesn't work with API keys)
    )
  end
end

