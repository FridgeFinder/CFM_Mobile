# Fastfile for iOS

default_platform(:ios)

platform :ios do
  desc "Generate screenshots for App Store"
  lane :screenshots do
    # Build the app for screenshots
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release"
    )
    
    # Capture screenshots
    capture_screenshots(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15 Pro",
        "iPhone 15",
        "iPhone SE (3rd generation)",
        "iPad Pro (12.9-inch) (6th generation)"
      ]
    )
    
    # Upload screenshots to App Store Connect
    upload_to_app_store(
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      skip_app_version_update: true
    )
  end

  desc "Build and upload to Firebase App Distribution"
  lane :beta do
    # Ensure we're on the correct branch/tag
    # ensure_git_status_clean
    
    # Set locale to UTF-8 to avoid CocoaPods warnings
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"
    
    # Install provisioning profile if provided via environment variable
    # Place your .mobileprovision file in ios/fastlane/profiles/ or set PROVISIONING_PROFILE_PATH
    if ENV["PROVISIONING_PROFILE_PATH"]
      install_provisioning_profile(
        path: ENV["PROVISIONING_PROFILE_PATH"]
      )
    elsif File.exist?("fastlane/profiles/dev-tester.mobileprovision")
      install_provisioning_profile(
        path: File.expand_path("fastlane/profiles/dev-tester.mobileprovision", __dir__)
      )
    end
    
    # Build the app using Flutter with manual signing
    # Flutter will run pod install automatically during the build
    # Even if it shows a CocoaPods warning, the build still succeeds
    export_options_path = File.expand_path("../ExportOptions.plist", __dir__)
    sh("cd .. && flutter build ipa --release --export-options-plist=#{export_options_path}")
    
    # Upload to Firebase App Distribution
    # Build parameters hash - only include app ID if explicitly set, otherwise use plist
    firebase_params = {
      googleservice_info_plist_path: "Runner/GoogleService-Info.plist",
      groups: ENV["FIREBASE_DISTRIBUTION_GROUPS"] || "dev-testers",
      release_notes: ENV["RELEASE_NOTES"] || "Beta build from Fastlane",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      ipa_path: "../build/ios/ipa/FridgeFinder.ipa"
    }
    firebase_params[:app] = ENV["FIREBASE_APP_ID_IOS"] if ENV["FIREBASE_APP_ID_IOS"]

    firebase_app_distribution(firebase_params)
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    # Ensure we're on the correct branch/tag
    # ensure_git_status_clean
    
    # Set locale to UTF-8 to avoid CocoaPods warnings
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"
    
    # Flutter will automatically run pod install during the build process
    # Even if it detects CocoaPods as "broken", it usually still works
    
    # Note: sync_code_signing removed due to issues - certificates should be managed via Xcode automatic signing
    # Or ensure certificates are already in keychain before building
    
    # Build the app using Flutter
    sh("cd .. && flutter build ipa --release")
    
    # Upload to App Store Connect
    upload_to_app_store(
      ipa: "../build/ios/ipa/FridgeFinder.ipa",
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: false
    )
  end
end

