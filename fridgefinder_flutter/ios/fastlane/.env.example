# Firebase App Distribution Configuration
# Copy this file to .env and fill in your values

# Firebase iOS App ID (from GoogleService-Info.plist)
FIREBASE_APP_ID_IOS=

# Firebase CLI Token - Generate by running: firebase login:ci
FIREBASE_CLI_TOKEN=

# App environment used by release lanes (must be prod)
APP_ENV=prod

# Distribution Groups (optional - defaults to "dev-testers")
# FIREBASE_DISTRIBUTION_GROUPS=dev-testers

# Release Notes (optional)
# RELEASE_NOTES=Beta build from Fastlane
